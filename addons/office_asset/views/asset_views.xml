<odoo>
    <record id="view_office_asset_list" model="ir.ui.view">
        <field name="name">office.asset.list</field>
        <field name="model">office.asset</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'available'" decoration-warning="state == 'assigned'" decoration-danger="state == 'damaged'">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="assigned_to" widget="many2one_avatar_user"/>
                <field name="age"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-info="state == 'new'"/>
            </list>
        </field>
    </record>

    <record id="view_office_asset_form" model="ir.ui.view">
        <field name="name">office.asset.form</field>
        <field name="model">office.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. MacBook Pro"/></h1>
                    </div>
                    <group>
                        <group string="Basic Info">
                            <field name="serial_number"/>
                            <field name="asset_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Financials">
                            <label for="price"/>
                            <div class="o_row">
                                <field name="price"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                            </div>
                            <field name="purchase_date"/>
                            <field name="age" class="text-info font-weight-bold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Management">
                            <group>
                                <field name="assigned_to" widget="many2one_avatar_user"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Condition reports..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_office_asset" model="ir.actions.act_window">
        <field name="name">Office Assets</field>
        <field name="res_model">office.asset</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_asset_root" name="Office Assets" sequence="10"/>
    <menuitem id="menu_asset_main" name="Inventory" parent="menu_asset_root" action="action_office_asset"/>
</odoo>