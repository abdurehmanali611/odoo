<odoo>
    <data>
        <!-- ================= INHERIT CRM FORM ================= -->
        <record id="crm_lead_form_inherit_custom" model="ir.ui.view">
            <field name="name">crm.lead.form.custom.workflow</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <!-- Hide Expected Revenue -->
                <xpath expr="//field[@name='expected_revenue']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Add Assignment Field -->
                <xpath expr="//sheet/group/group" position="after">
                    <group string="Assignment">
                        <field name="assigned_person_id"/>
                        <button name="action_assign"
                                type="object"
                                string="Assign"
                                class="btn-primary"/>
                    </group>
                </xpath>
                <!-- Process Stage Fields -->
                <xpath expr="//sheet/notebook" position="inside">
                    <page string="Process Information">
                        <group>
                            <field name="source_details"
               invisible="stage_id.name != 'Process'"/>
                            <field name="client_requirements"
               invisible="stage_id.name != 'Process'"/>
                            <field name="notes"
               invisible="stage_id.name != 'Process'"/>
                        </group>
                    </page>
                </xpath>
                <!-- Approval Section -->
                <xpath expr="//sheet" position="inside">
                    <group string="Approval">
                        <field name="approval_status" readonly="1"/>
                        <button name="action_approve"
                                type="object"
                                string="Approve"
                                class="btn-success"/>
                        <button name="action_reject"
                                type="object"
                                string="Reject"
                                class="btn-danger"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>